FROM vision60-autonomy:humble

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        python3-open3d=0.14.1+dfsg-7build3 \
        ros-humble-rosbag2-storage-mcap=0.15.16-1jammy.20260607.115643 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /ws

CMD ["bash"]
