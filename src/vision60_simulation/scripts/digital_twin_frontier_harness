#!/usr/bin/env python3
"""Validate frontier exploration pause, recovery, and safe resume."""

import json
import math
from pathlib import Path
import time

from action_msgs.srv import CancelGoal
import cv2
import numpy as np
import rclpy
from nav_msgs.msg import OccupancyGrid, Odometry, Path as RosPath
from rclpy.node import Node
from rclpy.qos import (
    DurabilityPolicy,
    QoSProfile,
    ReliabilityPolicy,
    qos_profile_sensor_data,
)
from sensor_msgs.msg import Image
from std_msgs.msg import Bool
from vision60_msgs.msg import (
    CommunicationState,
    RecoveryStatus,
    RobotSafetyState,
    SyncStatus,
)
from vision60_msgs.srv import RequestSafeStop, SetWalkEnabled
from visualization_msgs.msg import Marker, MarkerArray


STATE_NAMES = {
    RecoveryStatus.NORMAL: 'NORMAL',
    RecoveryStatus.DEGRADED: 'DEGRADED',
    RecoveryStatus.LINK_LOST: 'LINK_LOST',
    RecoveryStatus.STOPPING: 'STOPPING',
    RecoveryStatus.RETURNING: 'RETURNING',
    RecoveryStatus.LINK_RECOVERED: 'LINK_RECOVERED',
    RecoveryStatus.SYNCING: 'SYNCING',
    RecoveryStatus.REENTRY_TEST: 'REENTRY_TEST',
    RecoveryStatus.SAFE_STOP: 'SAFE_STOP',
    RecoveryStatus.CHANNEL_SWITCH: 'CHANNEL_SWITCH',
    RecoveryStatus.CLASSIFYING: 'CLASSIFYING',
}
OBSTACLES = (
    (2.0, 0.65, 0.70, 0.45, 0.35),
    (3.3, -0.55, 0.55, 0.50, -0.20),
)


def point_to_rotated_box(x_value, y_value, obstacle):
    """Return center-point distance to a rotated obstacle edge."""
    center_x, center_y, size_x, size_y, yaw = obstacle
    delta_x = x_value - center_x
    delta_y = y_value - center_y
    cosine = math.cos(yaw)
    sine = math.sin(yaw)
    local_x = cosine * delta_x + sine * delta_y
    local_y = -sine * delta_x + cosine * delta_y
    outside_x = max(abs(local_x) - size_x / 2.0, 0.0)
    outside_y = max(abs(local_y) - size_y / 2.0, 0.0)
    return math.hypot(outside_x, outside_y)


class FrontierExplorationHarness(Node):
    """Publish an incremental map and record the complete mission proof."""

    def __init__(self):
        super().__init__('digital_twin_frontier_harness')
        self.declare_parameter('output_dir', '/artifacts')
        self.declare_parameter('timeout_s', 135.0)
        self.output_dir = Path(self.get_parameter('output_dir').value)
        self.timeout_s = float(self.get_parameter('timeout_s').value)

        map_qos = QoSProfile(depth=1)
        map_qos.reliability = ReliabilityPolicy.RELIABLE
        map_qos.durability = DurabilityPolicy.TRANSIENT_LOCAL
        self.map_publisher = self.create_publisher(
            OccupancyGrid, '/map', map_qos
        )
        self.safety_publisher = self.create_publisher(
            RobotSafetyState, '/vision60/safety_state', 10
        )
        self.create_service(
            RequestSafeStop,
            '/vision60/request_safe_stop',
            self.safe_stop_callback,
        )
        self.create_service(
            SetWalkEnabled,
            '/vision60/set_walk_enabled',
            self.walk_enable_callback,
        )
        self.nav_cancel_client = self.create_client(
            CancelGoal, '/navigate_to_pose/_action/cancel_goal'
        )
        self.path_cancel_client = self.create_client(
            CancelGoal, '/follow_path/_action/cancel_goal'
        )
        self.create_subscription(
            Odometry, '/vision60/odom', self.odom_callback, 30
        )
        self.create_subscription(
            Image, '/camera/image_raw', self.image_callback,
            qos_profile_sensor_data,
        )
        self.create_subscription(
            CommunicationState, '/communication/state',
            self.communication_callback, 20,
        )
        self.create_subscription(
            RecoveryStatus, '/communication/recovery_status',
            self.status_callback, 20,
        )
        self.create_subscription(
            SyncStatus, '/mission/sync_status', self.sync_callback, 10
        )
        self.create_subscription(
            RosPath, '/mission/recovery_path', self.path_callback, 10
        )
        self.create_subscription(
            Bool, '/mission/exploration_allowed',
            self.exploration_callback, 10,
        )
        self.create_subscription(
            MarkerArray, '/explore/frontiers',
            self.frontier_callback, 10,
        )
        self.create_timer(0.10, self.tick)

        self.resolution = 0.05
        self.origin_x = -1.0
        self.origin_y = -2.0
        self.width = 140
        self.height = 80
        self.sensor_radius = 1.15
        self.ground_truth = self.build_ground_truth()
        self.discovered = np.zeros(
            (self.height, self.width), dtype=np.bool_
        )
        self.navigable_mask = self.ground_truth == 0

        self.started_at = time.monotonic()
        self.last_map_publish = 0.0
        self.last_frame_time = 0.0
        self.odom = None
        self.latest_image = None
        self.walk_enabled = True
        self.comm_state = CommunicationState.UNKNOWN
        self.active_channel = 'mock_ethernet'
        self.recovery_state = RecoveryStatus.NORMAL
        self.exploration_allowed = False
        self.state_sequence = []
        self.gate_sequence = []
        self.frontier_count = 0
        self.max_frontier_count = 0
        self.recovery_path_points = 0
        self.sync_complete = False
        self.seen_reentry = False
        self.safe_stop_pose = None
        self.resume_pose = None
        self.positions = []
        self.frames = []
        self.final_ready_time = None
        self.written = False

    def build_ground_truth(self):
        """Build the known world used only by the simulated mapper."""
        grid = np.zeros((self.height, self.width), dtype=np.int8)
        for row in range(self.height):
            y_value = self.origin_y + (row + 0.5) * self.resolution
            for column in range(self.width):
                x_value = self.origin_x + (column + 0.5) * self.resolution
                occupied = (
                    x_value <= -0.65
                    or x_value >= 5.55
                    or y_value <= -1.35
                    or y_value >= 1.35
                )
                if not occupied:
                    for obstacle in OBSTACLES:
                        center_x, center_y, size_x, size_y, yaw = obstacle
                        delta_x = x_value - center_x
                        delta_y = y_value - center_y
                        cosine = math.cos(yaw)
                        sine = math.sin(yaw)
                        local_x = cosine * delta_x + sine * delta_y
                        local_y = -sine * delta_x + cosine * delta_y
                        if (
                            abs(local_x) <= size_x / 2.0
                            and abs(local_y) <= size_y / 2.0
                        ):
                            occupied = True
                            break
                grid[row, column] = 100 if occupied else 0
        return grid

    def odom_callback(self, message):
        self.odom = message
        position = message.pose.pose.position
        x_value = float(position.x)
        y_value = float(position.y)
        self.positions.append((
            x_value, y_value, int(self.recovery_state),
            bool(self.exploration_allowed),
        ))
        self.reveal_map(x_value, y_value)

    def image_callback(self, message):
        now = time.monotonic()
        if now - self.last_frame_time < 0.10:
            return
        raw = np.frombuffer(message.data, dtype=np.uint8)
        expected = int(message.height) * int(message.step)
        if expected <= 0 or raw.size < expected:
            return
        if message.step < message.width * 3:
            return
        frame = raw[:expected].reshape(int(message.height), int(message.step))
        frame = frame[:, :int(message.width) * 3].reshape(
            int(message.height), int(message.width), 3
        )
        if message.encoding.lower() == 'rgb8':
            frame = cv2.cvtColor(frame, cv2.COLOR_RGB2BGR)
        self.latest_image = frame.copy()
        if self.odom is None:
            return
        ok, encoded = cv2.imencode(
            '.jpg', frame, [cv2.IMWRITE_JPEG_QUALITY, 72]
        )
        if not ok:
            return
        position = self.odom.pose.pose.position
        self.frames.append((
            encoded.tobytes(),
            float(position.x), float(position.y),
            int(self.recovery_state), int(self.comm_state),
            self.active_channel, bool(self.exploration_allowed),
            self.revealed_ratio(), int(self.frontier_count),
        ))
        self.last_frame_time = now

    def communication_callback(self, message):
        self.comm_state = int(message.state)
        self.active_channel = message.channel

    def status_callback(self, message):
        state = int(message.state)
        self.recovery_state = state
        if not self.state_sequence or self.state_sequence[-1] != state:
            self.state_sequence.append(state)
            self.get_logger().warning(
                'Frontier recovery state: '
                + STATE_NAMES.get(state, str(state))
            )
        if state == RecoveryStatus.REENTRY_TEST:
            self.seen_reentry = True

    def sync_callback(self, message):
        if message.state == SyncStatus.COMPLETE:
            self.sync_complete = True

    def path_callback(self, message):
        self.recovery_path_points = max(
            self.recovery_path_points, len(message.poses)
        )

    def exploration_callback(self, message):
        allowed = bool(message.data)
        self.exploration_allowed = allowed
        if not self.gate_sequence or self.gate_sequence[-1] != allowed:
            self.gate_sequence.append(allowed)
            self.get_logger().warning(
                'Exploration gate: ' + ('RESUME' if allowed else 'PAUSE')
            )
        if (
            allowed
            and self.seen_reentry
            and self.recovery_state == RecoveryStatus.NORMAL
            and self.odom is not None
            and self.resume_pose is None
        ):
            position = self.odom.pose.pose.position
            self.resume_pose = (
                float(position.x), float(position.y), time.monotonic()
            )

    def frontier_callback(self, message):
        count = sum(
            1 for marker in message.markers
            if marker.action == Marker.ADD and marker.type == Marker.SPHERE
        )
        self.frontier_count = count
        self.max_frontier_count = max(self.max_frontier_count, count)

    def safe_stop_callback(self, request, response):
        self.walk_enabled = False
        if self.odom is not None:
            position = self.odom.pose.pose.position
            self.safe_stop_pose = (
                float(position.x), float(position.y)
            )
        for client in (self.nav_cancel_client, self.path_cancel_client):
            if client.service_is_ready():
                cancel = CancelGoal.Request()
                cancel.goal_info.goal_id.uuid = [0] * 16
                client.call_async(cancel)
        response.accepted = True
        response.message = f'Frontier navigation stopped: {request.reason}'
        self.get_logger().warning(response.message)
        return response

    def walk_enable_callback(self, request, response):
        self.walk_enabled = bool(request.enabled)
        response.accepted = True
        response.message = 'Recovery-only walking permission updated'
        return response

    def reveal_map(self, x_value, y_value):
        """Reveal cells within the idealized LiDAR mapping radius."""
        xs = self.origin_x + (
            np.arange(self.width, dtype=np.float32) + 0.5
        ) * self.resolution
        ys = self.origin_y + (
            np.arange(self.height, dtype=np.float32) + 0.5
        ) * self.resolution
        xx, yy = np.meshgrid(xs, ys)
        visible = (
            (xx - x_value) ** 2 + (yy - y_value) ** 2
            <= self.sensor_radius ** 2
        )
        self.discovered |= visible

    def revealed_ratio(self):
        known_navigable = np.count_nonzero(
            self.discovered & self.navigable_mask
        )
        total_navigable = np.count_nonzero(self.navigable_mask)
        return (
            float(known_navigable) / float(total_navigable)
            if total_navigable else 0.0
        )

    def publish_map(self):
        if self.odom is None:
            return
        data = np.full(
            (self.height, self.width), -1, dtype=np.int8
        )
        data[self.discovered] = self.ground_truth[self.discovered]
        message = OccupancyGrid()
        message.header.stamp = self.get_clock().now().to_msg()
        message.header.frame_id = 'odom'
        message.info.map_load_time = message.header.stamp
        message.info.resolution = self.resolution
        message.info.width = self.width
        message.info.height = self.height
        message.info.origin.position.x = self.origin_x
        message.info.origin.position.y = self.origin_y
        message.info.origin.orientation.w = 1.0
        message.data = data.reshape(-1).astype(int).tolist()
        self.map_publisher.publish(message)

    def publish_safety(self):
        message = RobotSafetyState()
        message.header.stamp = self.get_clock().now().to_msg()
        message.header.frame_id = 'base_link'
        message.walk_enabled = self.walk_enabled
        message.localization_healthy = self.odom is not None
        message.lidar_healthy = True
        message.sdk_connected = True
        message.motion_allowed = self.walk_enabled
        message.stop_reason = (
            '' if self.walk_enabled else 'communication link lost'
        )
        self.safety_publisher.publish(message)

    def tick(self):
        now = time.monotonic()
        self.publish_safety()
        if now - self.last_map_publish >= 0.20:
            self.publish_map()
            self.last_map_publish = now
        if self.ready_for_result(now) and self.final_ready_time is None:
            self.final_ready_time = now + 4.0
        if (
            self.final_ready_time is not None
            and now >= self.final_ready_time
            and not self.written
        ):
            self.written = True
            self.write_artifacts()
        elif now - self.started_at >= self.timeout_s and not self.written:
            self.written = True
            self.write_artifacts(force_fail=True)

    def ready_for_result(self, now):
        if (
            self.resume_pose is None
            or self.odom is None
            or not self.sync_complete
            or self.recovery_state != RecoveryStatus.NORMAL
            or not self.exploration_allowed
        ):
            return False
        start_x, start_y, resume_time = self.resume_pose
        position = self.odom.pose.pose.position
        resumed_distance = math.hypot(
            float(position.x) - start_x,
            float(position.y) - start_y,
        )
        return now - resume_time >= 3.0 and resumed_distance >= 0.25

    def calculate_metrics(self, force_fail=False):
        returning = [
            (x_value, y_value)
            for x_value, y_value, state, _ in self.positions
            if state == RecoveryStatus.RETURNING
        ]
        return_distance = 0.0
        if self.safe_stop_pose is not None:
            stop_x, stop_y = self.safe_stop_pose
            return_distance = max((
                math.hypot(x_value - stop_x, y_value - stop_y)
                for x_value, y_value in returning
            ), default=0.0)
        clearances = [
            min(
                point_to_rotated_box(x_value, y_value, obstacle)
                for obstacle in OBSTACLES
            ) - 0.30
            for x_value, y_value, _, _ in self.positions
        ]
        wall_clearances = [
            1.225 - abs(y_value) - 0.30
            for _, y_value, _, _ in self.positions
        ]
        resumed_distance = 0.0
        if self.resume_pose is not None and self.positions:
            start_x, start_y, _ = self.resume_pose
            final_x, final_y, _, _ = self.positions[-1]
            resumed_distance = math.hypot(
                final_x - start_x, final_y - start_y
            )
        required_states = {
            RecoveryStatus.STOPPING,
            RecoveryStatus.RETURNING,
            RecoveryStatus.CHANNEL_SWITCH,
            RecoveryStatus.SYNCING,
            RecoveryStatus.REENTRY_TEST,
        }
        gate_pattern = any(
            self.gate_sequence[index:index + 3] == [True, False, True]
            for index in range(max(len(self.gate_sequence) - 2, 0))
        )
        maximum_x = max(
            (value[0] for value in self.positions), default=0.0
        )
        minimum_clearance = min(clearances, default=-1.0)
        minimum_wall_clearance = min(wall_clearances, default=-1.0)
        passed = bool(
            not force_fail
            and required_states <= set(self.state_sequence)
            and gate_pattern
            and self.max_frontier_count >= 1
            and self.revealed_ratio() >= 0.32
            and maximum_x >= 1.60
            and self.recovery_path_points >= 2
            and return_distance >= 0.25
            and resumed_distance >= 0.25
            and minimum_clearance >= 0.03
            and minimum_wall_clearance >= 0.05
            and self.sync_complete
            and self.active_channel == 'mock_backup_wifi'
            and self.recovery_state == RecoveryStatus.NORMAL
            and self.exploration_allowed
            and len(self.frames) >= 40
        )
        final_x = self.positions[-1][0] if self.positions else 0.0
        final_y = self.positions[-1][1] if self.positions else 0.0
        return {
            'passed': passed,
            'frontier_engine': (
                'robo-friends/m-explore-ros2@326cf8a0b487'
            ),
            'maximum_frontier_count': self.max_frontier_count,
            'revealed_navigable_ratio': round(self.revealed_ratio(), 4),
            'maximum_x_m': round(maximum_x, 4),
            'minimum_obstacle_clearance_m': round(minimum_clearance, 4),
            'minimum_wall_clearance_m': round(
                minimum_wall_clearance, 4
            ),
            'exploration_gate_sequence': self.gate_sequence,
            'recovery_state_sequence': [
                STATE_NAMES.get(value, str(value))
                for value in self.state_sequence
            ],
            'recovery_path_points': self.recovery_path_points,
            'return_distance_m': round(return_distance, 4),
            'resumed_exploration_distance_m': round(
                resumed_distance, 4
            ),
            'sync_complete': self.sync_complete,
            'final_channel': self.active_channel,
            'final_x_m': round(final_x, 4),
            'final_y_m': round(final_y, 4),
            'video_frames': len(self.frames),
        }

    def write_artifacts(self, force_fail=False):
        self.output_dir.mkdir(parents=True, exist_ok=True)
        metrics = self.calculate_metrics(force_fail)
        (self.output_dir / 'frontier_exploration_report.json').write_text(
            json.dumps(metrics, ensure_ascii=False, indent=2),
            encoding='utf-8',
        )
        self.render_video(metrics)
        marker = 'PASS' if metrics['passed'] else 'FAIL'
        (self.output_dir / marker).write_text(
            'frontier exploration with communication recovery\n',
            encoding='utf-8',
        )
        self.get_logger().warning(
            'DIGITAL_TWIN_FRONTIER_EXPLORATION=' + marker
            + f" revealed={metrics['revealed_navigable_ratio']:.3f}"
            + f" return={metrics['return_distance_m']:.3f}m"
            + ' resumed='
            + f"{metrics['resumed_exploration_distance_m']:.3f}m"
        )

    def render_video(self, metrics):
        output = self.output_dir / 'digital_twin_frontier_exploration.mp4'
        writer = cv2.VideoWriter(
            str(output), cv2.VideoWriter_fourcc(*'mp4v'),
            10.0, (960, 540)
        )
        if not writer.isOpened():
            raise RuntimeError('Could not create frontier exploration MP4')
        colors = {
            RecoveryStatus.NORMAL: (255, 205, 55),
            RecoveryStatus.DEGRADED: (60, 210, 255),
            RecoveryStatus.STOPPING: (65, 95, 245),
            RecoveryStatus.RETURNING: (55, 160, 255),
            RecoveryStatus.CHANNEL_SWITCH: (210, 150, 80),
            RecoveryStatus.SYNCING: (200, 180, 80),
            RecoveryStatus.REENTRY_TEST: (220, 100, 220),
        }
        track = []
        last_canvas = None
        for sample in self.frames:
            (
                encoded, x_value, y_value, state, comm, channel,
                allowed, revealed, frontier_count,
            ) = sample
            camera = cv2.imdecode(
                np.frombuffer(encoded, dtype=np.uint8), cv2.IMREAD_COLOR
            )
            if camera is None:
                continue
            track.append((x_value, y_value, state))
            canvas = np.full((540, 960, 3), (22, 26, 31), dtype=np.uint8)
            camera_panel = cv2.resize(
                camera, (600, 450), interpolation=cv2.INTER_NEAREST
            )
            canvas[62:512, 20:620] = camera_panel
            cv2.putText(
                canvas, 'AUTONOMOUS FRONTIER + COMM RECOVERY',
                (20, 39), cv2.FONT_HERSHEY_SIMPLEX, 0.60,
                (235, 240, 244), 2, cv2.LINE_AA,
            )
            state_name = STATE_NAMES.get(state, str(state))
            cv2.putText(
                canvas, state_name, (650, 39),
                cv2.FONT_HERSHEY_SIMPLEX, 0.54,
                colors.get(state, (225, 232, 237)), 2, cv2.LINE_AA,
            )
            left, top, width, height = 650, 62, 290, 450
            cv2.rectangle(
                canvas, (left, top), (left + width, top + height),
                (52, 60, 68), -1
            )
            scale = 47.0
            origin = (left + 38, top + height // 2)

            def pixel(world_x, world_y):
                return (
                    int(origin[0] + world_x * scale),
                    int(origin[1] - world_y * scale),
                )

            for wall_y in (-1.35, 1.35):
                cv2.line(
                    canvas, pixel(-0.6, wall_y), pixel(5.55, wall_y),
                    (112, 101, 91), 10
                )
            cv2.line(
                canvas, pixel(-0.65, -1.35), pixel(-0.65, 1.35),
                (112, 101, 91), 10
            )
            cv2.line(
                canvas, pixel(5.55, -1.35), pixel(5.55, 1.35),
                (112, 101, 91), 10
            )
            for obstacle in OBSTACLES:
                center_x, center_y, size_x, size_y, yaw = obstacle
                rectangle = (
                    pixel(center_x, center_y),
                    (int(size_x * scale), int(size_y * scale)),
                    -math.degrees(yaw),
                )
                corners = cv2.boxPoints(rectangle).astype(np.int32)
                cv2.fillConvexPoly(canvas, corners, (92, 72, 56))
            for index in range(1, len(track)):
                previous = track[index - 1]
                current = track[index]
                cv2.line(
                    canvas, pixel(previous[0], previous[1]),
                    pixel(current[0], current[1]),
                    colors.get(current[2], (225, 232, 237)),
                    3, cv2.LINE_AA,
                )
            if track:
                cv2.circle(
                    canvas, pixel(track[0][0], track[0][1]),
                    6, (70, 210, 110), -1
                )
            cv2.circle(
                canvas, pixel(x_value, y_value),
                8, (65, 95, 245), -1
            )
            cv2.circle(
                canvas, pixel(x_value, y_value),
                int(self.sensor_radius * scale), (120, 145, 160), 1
            )
            gate_text = 'EXPLORE' if allowed else 'PAUSED'
            cv2.putText(
                canvas, gate_text, (left + 15, top + 26),
                cv2.FONT_HERSHEY_SIMPLEX, 0.48,
                (80, 220, 120) if allowed else (65, 95, 245),
                1, cv2.LINE_AA,
            )
            link_text = (
                'LINK LOST'
                if comm == CommunicationState.LOST
                else 'LINK CONNECTED'
            )
            cv2.putText(
                canvas, link_text, (left + 15, top + 50),
                cv2.FONT_HERSHEY_SIMPLEX, 0.42,
                (65, 95, 245)
                if comm == CommunicationState.LOST
                else (80, 220, 120),
                1, cv2.LINE_AA,
            )
            cv2.putText(
                canvas, f'frontiers={frontier_count}',
                (left + 15, top + 76), cv2.FONT_HERSHEY_SIMPLEX,
                0.40, (80, 200, 255), 1, cv2.LINE_AA,
            )
            cv2.putText(
                canvas, f'map={revealed * 100:.1f}%',
                (left + 15, top + 100), cv2.FONT_HERSHEY_SIMPLEX,
                0.40, (225, 232, 237), 1, cv2.LINE_AA,
            )
            cv2.putText(
                canvas, f'x={x_value:.2f} y={y_value:.2f}',
                (left + 15, top + 390), cv2.FONT_HERSHEY_SIMPLEX,
                0.43, (225, 232, 237), 1, cv2.LINE_AA,
            )
            cv2.putText(
                canvas, channel[:24], (left + 15, top + 420),
                cv2.FONT_HERSHEY_SIMPLEX, 0.38,
                (160, 175, 185), 1, cv2.LINE_AA,
            )
            writer.write(canvas)
            last_canvas = canvas
        writer.release()
        if last_canvas is not None:
            marker = 'PASS' if metrics['passed'] else 'FAIL'
            cv2.putText(
                last_canvas, marker, (850, 39),
                cv2.FONT_HERSHEY_SIMPLEX, 0.65,
                (80, 220, 120)
                if metrics['passed'] else (65, 95, 245),
                2, cv2.LINE_AA,
            )
            cv2.imwrite(
                str(self.output_dir / 'frontier_exploration_result.png'),
                last_canvas,
            )


def main(args=None):
    rclpy.init(args=args)
    node = FrontierExplorationHarness()
    try:
        rclpy.spin(node)
    finally:
        node.destroy_node()
        rclpy.shutdown()


if __name__ == '__main__':
    main()
