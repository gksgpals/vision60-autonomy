<?xml version="1.0"?>
<!-- Copyright 2026 Kookmin AI Lab, Apache-2.0 -->
<sdf version="1.8">
  <world name="vision60_disaster_test">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="ignition-gazebo-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="ignition-gazebo-imu-system" name="gz::sim::systems::Imu"/>

    <light type="directional" name="sun">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="ground">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
          <material><ambient>0.25 0.24 0.22 1</ambient><diffuse>0.45 0.42 0.38 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="collapsed_wall_left">
      <static>true</static><pose>3.0 1.35 0.8 0 0 0</pose>
      <link name="wall"><collision name="collision"><geometry><box><size>4.0 0.25 1.6</size></box></geometry></collision><visual name="visual"><geometry><box><size>4.0 0.25 1.6</size></box></geometry><material><diffuse>0.42 0.38 0.34 1</diffuse></material></visual></link>
    </model>
    <model name="collapsed_wall_right">
      <static>true</static><pose>3.0 -1.35 0.8 0 0 0</pose>
      <link name="wall"><collision name="collision"><geometry><box><size>4.0 0.25 1.6</size></box></geometry></collision><visual name="visual"><geometry><box><size>4.0 0.25 1.6</size></box></geometry><material><diffuse>0.42 0.38 0.34 1</diffuse></material></visual></link>
    </model>
    <model name="rubble_block_1">
      <static>true</static><pose>2.0 0.65 0.20 0.15 0.10 0.35</pose>
      <link name="rubble"><collision name="collision"><geometry><box><size>0.70 0.45 0.40</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.70 0.45 0.40</size></box></geometry><material><diffuse>0.35 0.28 0.22 1</diffuse></material></visual></link>
    </model>
    <model name="rubble_block_2">
      <static>true</static><pose>3.3 -0.55 0.15 -0.12 0.18 -0.2</pose>
      <link name="rubble"><collision name="collision"><geometry><box><size>0.55 0.50 0.30</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.55 0.50 0.30</size></box></geometry><material><diffuse>0.40 0.31 0.24 1</diffuse></material></visual></link>
    </model>
    <model name="inclined_slab">
      <static>true</static><pose>6.5 0 0.28 0 -0.14 0</pose>
      <link name="slab"><collision name="collision"><geometry><box><size>2.6 1.4 0.15</size></box></geometry></collision><visual name="visual"><geometry><box><size>2.6 1.4 0.15</size></box></geometry><material><diffuse>0.50 0.48 0.45 1</diffuse></material></visual></link>
    </model>

    <include><uri>model://vision60</uri><name>vision60</name></include>
  </world>
</sdf>
