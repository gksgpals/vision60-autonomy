<?xml version="1.0"?>
<!-- Copyright 2026 Kookmin AI Lab, Apache-2.0 -->
<sdf version="1.8">
  <model name="vision60">
    <pose>0 0 0.55 0 0 0</pose>
    <static>false</static>
    <self_collide>false</self_collide>
    <link name="base_link">
      <inertial>
        <mass>51.0</mass>
        <inertia>
          <ixx>0.471325</ixx>
          <iyy>2.001325</iyy>
          <izz>2.061250</izz>
        </inertia>
      </inertial>

      <collision name="body_collision">
        <geometry><box><size>0.65 0.25 0.22</size></box></geometry>
        <surface>
          <friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction>
        </surface>
      </collision>
      <visual name="body_visual">
        <geometry><box><size>0.65 0.25 0.22</size></box></geometry>
        <material>
          <ambient>0.08 0.10 0.12 1</ambient>
          <diffuse>0.16 0.20 0.24 1</diffuse>
          <specular>0.35 0.35 0.35 1</specular>
        </material>
      </visual>

      <collision name="front_left_leg_collision">
        <pose>0.40 0.235 -0.32 0 0 0</pose>
        <geometry><cylinder><radius>0.035</radius><length>0.42</length></cylinder></geometry>
      </collision>
      <visual name="front_left_leg_visual">
        <pose>0.40 0.235 -0.32 0 0 0</pose>
        <geometry><cylinder><radius>0.035</radius><length>0.42</length></cylinder></geometry>
        <material><diffuse>0.10 0.12 0.14 1</diffuse></material>
      </visual>
      <collision name="front_right_leg_collision">
        <pose>0.40 -0.235 -0.32 0 0 0</pose>
        <geometry><cylinder><radius>0.035</radius><length>0.42</length></cylinder></geometry>
      </collision>
      <visual name="front_right_leg_visual">
        <pose>0.40 -0.235 -0.32 0 0 0</pose>
        <geometry><cylinder><radius>0.035</radius><length>0.42</length></cylinder></geometry>
        <material><diffuse>0.10 0.12 0.14 1</diffuse></material>
      </visual>
      <collision name="rear_left_leg_collision">
        <pose>-0.40 0.235 -0.32 0 0 0</pose>
        <geometry><cylinder><radius>0.035</radius><length>0.42</length></cylinder></geometry>
      </collision>
      <visual name="rear_left_leg_visual">
        <pose>-0.40 0.235 -0.32 0 0 0</pose>
        <geometry><cylinder><radius>0.035</radius><length>0.42</length></cylinder></geometry>
        <material><diffuse>0.10 0.12 0.14 1</diffuse></material>
      </visual>
      <collision name="rear_right_leg_collision">
        <pose>-0.40 -0.235 -0.32 0 0 0</pose>
        <geometry><cylinder><radius>0.035</radius><length>0.42</length></cylinder></geometry>
      </collision>
      <visual name="rear_right_leg_visual">
        <pose>-0.40 -0.235 -0.32 0 0 0</pose>
        <geometry><cylinder><radius>0.035</radius><length>0.42</length></cylinder></geometry>
        <material><diffuse>0.10 0.12 0.14 1</diffuse></material>
      </visual>

      <collision name="front_left_foot_collision">
        <pose>0.40 0.235 -0.53 0 0 0</pose>
        <geometry><sphere><radius>0.05</radius></sphere></geometry>
        <surface><friction><ode><mu>1.4</mu><mu2>1.4</mu2></ode></friction></surface>
      </collision>
      <collision name="front_right_foot_collision">
        <pose>0.40 -0.235 -0.53 0 0 0</pose>
        <geometry><sphere><radius>0.05</radius></sphere></geometry>
        <surface><friction><ode><mu>1.4</mu><mu2>1.4</mu2></ode></friction></surface>
      </collision>
      <collision name="rear_left_foot_collision">
        <pose>-0.40 0.235 -0.53 0 0 0</pose>
        <geometry><sphere><radius>0.05</radius></sphere></geometry>
        <surface><friction><ode><mu>1.4</mu><mu2>1.4</mu2></ode></friction></surface>
      </collision>
      <collision name="rear_right_foot_collision">
        <pose>-0.40 -0.235 -0.53 0 0 0</pose>
        <geometry><sphere><radius>0.05</radius></sphere></geometry>
        <surface><friction><ode><mu>1.4</mu><mu2>1.4</mu2></ode></friction></surface>
      </collision>

      <visual name="sensor_head_visual">
        <pose>0.20 0 0.30 0 0 0</pose>
        <geometry><cylinder><radius>0.07</radius><length>0.10</length></cylinder></geometry>
        <material><diffuse>0.05 0.35 0.55 1</diffuse></material>
      </visual>

      <sensor name="imu" type="imu">
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <topic>vision60/sim/imu</topic>
        <gz_frame_id>base_link</gz_frame_id>
        <imu>
          <angular_velocity>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.0002</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.0002</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.0002</stddev></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.002</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.002</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.002</stddev></noise></z>
          </linear_acceleration>
        </imu>
      </sensor>

      <sensor name="ouster" type="gpu_lidar">
        <pose>0.20 0 0.45 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <topic>ouster</topic>
        <gz_frame_id>os_sensor</gz_frame_id>
        <lidar>
          <scan>
            <horizontal>
              <samples>640</samples><resolution>1</resolution>
              <min_angle>-3.14159265</min_angle><max_angle>3.14159265</max_angle>
            </horizontal>
            <vertical>
              <samples>16</samples><resolution>1</resolution>
              <min_angle>-0.261799</min_angle><max_angle>0.261799</max_angle>
            </vertical>
          </scan>
          <range><min>0.10</min><max>30.0</max><resolution>0.01</resolution></range>
          <noise><type>gaussian</type><mean>0</mean><stddev>0.01</stddev></noise>
        </lidar>
      </sensor>

      <sensor name="front_camera" type="camera">
        <pose>0.33 0 0.35 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <topic>camera/image_raw</topic>
        <gz_frame_id>camera_optical</gz_frame_id>
        <camera name="front_camera">
          <camera_info_topic>camera/camera_info</camera_info_topic>
          <horizontal_fov>1.256637</horizontal_fov>
          <image><width>160</width><height>120</height><format>R8G8B8</format></image>
          <clip><near>0.10</near><far>30.0</far></clip>
          <noise><type>gaussian</type><mean>0</mean><stddev>0.003</stddev></noise>
        </camera>
      </sensor>
    </link>

    <plugin filename="ignition-gazebo-pose-publisher-system"
            name="gz::sim::systems::PosePublisher">
      <publish_model_pose>true</publish_model_pose>
      <publish_link_pose>true</publish_link_pose>
      <publish_sensor_pose>true</publish_sensor_pose>
      <use_pose_vector_msg>true</use_pose_vector_msg>
      <update_frequency>30</update_frequency>
    </plugin>
    <plugin filename="ignition-gazebo-velocity-control-system"
            name="gz::sim::systems::VelocityControl">
      <topic>/model/vision60/cmd_vel</topic>
    </plugin>
  </model>
</sdf>
