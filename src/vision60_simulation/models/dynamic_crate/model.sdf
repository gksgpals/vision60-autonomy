<?xml version="1.0"?>
<sdf version="1.8">
  <model name="dynamic_crate">
    <static>false</static>
    <link name="crate_link">
      <inertial>
        <mass>18.0</mass>
        <inertia>
          <ixx>0.9075</ixx><iyy>0.9075</iyy><izz>0.9075</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry><box><size>0.55 0.55 0.60</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>0.55 0.55 0.60</size></box></geometry>
        <material>
          <ambient>0.55 0.12 0.08 1</ambient>
          <diffuse>0.75 0.18 0.10 1</diffuse>
        </material>
      </visual>
    </link>
    <plugin filename="ignition-gazebo-velocity-control-system"
            name="gz::sim::systems::VelocityControl">
      <topic>/model/dynamic_crate/cmd_vel</topic>
    </plugin>
  </model>
</sdf>
